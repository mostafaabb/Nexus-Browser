# Nexus Browser — optional environment configuration
#
# Copy to `.env` and fill in values if you want to override build-time defaults.
# NEVER place API keys in this file. API credentials are stored through the
# operating system credential vault via Electron's `safeStorage` API and are
# entered at runtime in Settings → AI.

# Default search engine used by the address bar (google | bing | duckduckgo | brave | custom)
NEXUS_DEFAULT_SEARCH_ENGINE=duckduckgo

# Optional: default AI provider id used on first run (mock | openai-compatible)
NEXUS_DEFAULT_AI_PROVIDER=mock

# Optional: name of the Electron session partition used for private browsing
NEXUS_PRIVATE_PARTITION=nexus-private

# Set to "true" to disable GPU hardware acceleration (useful in CI / VMs)
NEXUS_DISABLE_GPU=false
